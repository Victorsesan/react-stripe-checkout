package com.opentelemetry.android;

import io.opentelemetry.sdk.common.CompletableResultCode;
import io.opentelemetry.sdk.trace.data.SpanData;
import io.opentelemetry.sdk.trace.export.SpanExporter;
import java.time.Duration;
import java.util.Collection;
import java.util.concurrent.atomic.AtomicIntege;
import java.util.concurrent.atomic.AtomicLong;

public final class RateLimitedExporter implements SpanExporter {
    private final SpanExporter delegate;
    private final int maxSpansPerPeriod;
    private final long periodMillis;
    private final AtomicLong periodStartTime;
    private final AtomicInteger spansExportedInPeriod;

    private RateLimitedExporter(Builder builder) {
        this.delegate = builder.delegate;
        this.maxSpansPerPeriod = builder.maxSpansPerPeriod;
        this.periodMillis = builder.period.toMillis();
        // Since we are also running versions older than 8.0, we will use  System.currentTimeMillis() instead of java.time.Clock.
        this.periodStartTime = new AtomicLong(System.currentTimeMillis());
        this.spansExportedInPeriod = new AtomicInteger(0);
    }

    public static Builder newBuilder(SpanExporter delegate) {
        return new Builder(delegate);
    }

    @Override
    public CompletableResultCode export(Collection<SpanData> spans) {
        // This check if the time window has elapsed and reset if necessary.
        long now = System.currentTimeMillis();
        long currentPeriodStart = periodStartTime.get();
        if (now - currentPeriodStart > periodMillis) {
            periodStartTime.set(now);
            spansExportedInPeriod.set(0);
        }

        // If the number of spans exported in the current window has reached the max, It will return a failure to signal backpressure to the caller.
        if (spansExportedInPeriod.get() >= maxSpansPerPeriod) {
            return CompletableResultCode.ofFailure();
        }

        // Export the whole batch and update the count upon success.
        // This "lets the last batch through" even if it exceeds the limit.
        CompletableResultCode result = delegate.export(spans);
        result.whenComplete(
                () -> {
                    if (result.isSuccess()) {
                        spansExportedInPeriod.addAndGet(spans.size());
                    }
                });
        return result;
    }

    @Override
    public CompletableResultCode flush() {
        return delegate.flush();
    }

    @Override
    public CompletableResultCode shutdown() {
        return delegate.shutdown();
    }

    public static class Builder {
        private final SpanExporter delegate;
        private int maxSpansPerPeriod = 100;
        private Duration period = Duration.ofSeconds(60);

        private Builder(SpanExporter delegate) {
            this.delegate = delegate;
        }

        public Builder maxSpansPerPeriod(int maxSpansPerPeriod) {
            this.maxSpansPerPeriod = maxSpansPerPeriod;
            return this;
        }

        public Builder setPeriod(Duration period) {
            this.period = period;
            return this;
        }

        public RateLimitedExporter build() {
            return new RateLimitedExporter(this);
        }
    }
}
